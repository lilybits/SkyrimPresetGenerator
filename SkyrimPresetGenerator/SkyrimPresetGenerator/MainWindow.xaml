<Window x:Class="SkyrimPresetGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skyrim Preset Generator"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterScreen">

    <!-- very rough!!! will make pretty later-->
    
    <!-- main layout -->
    <Grid Margin="40">

        <StackPanel>

            <!-- title -->
            <TextBlock Text="Skyrim Preset Generator"
                       FontSize="32"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,35"/>

            <!-- race selection -->
            <TextBlock Text="Race"
                       FontSize="16"
                       Margin="0,0,0,5"/>

            <ComboBox x:Name="RaceComboBox"
                      Height="35"
                      SelectedIndex="0"
                      Margin="0,0,0,20">

                <ComboBoxItem Content="Random"/>
                <ComboBoxItem Content="Altmer"/>
                <ComboBoxItem Content="Argonian"/>
                <ComboBoxItem Content="Bosmer"/>
                <ComboBoxItem Content="Breton"/>
                <ComboBoxItem Content="Dunmer"/>
                <ComboBoxItem Content="Imperial"/>
                <ComboBoxItem Content="Khajiit"/>
                <ComboBoxItem Content="Nord"/>
                <ComboBoxItem Content="Orc"/>
                <ComboBoxItem Content="Redguard"/>

            </ComboBox>

            <!-- sex selection -->
            <TextBlock Text="Sex"
                       FontSize="16"
                       Margin="0,0,0,5"/>

            <ComboBox x:Name="SexComboBox"
                      Height="35"
                      SelectedIndex="0"
                      Margin="0,0,0,25">

                <ComboBoxItem Content="Random"/>
                <ComboBoxItem Content="Female"/>
                <ComboBoxItem Content="Male"/>

            </ComboBox>

            <!-- generate random preset button -->
            <Button x:Name="GenerateButton"
                    Content="Generate Preset"
                    Width="200"
                    Height="45"
                    FontSize="16"
                    HorizontalAlignment="Center"
                    Click="GenerateButton_Click"
                    Margin="0,0,0,30"/>

            <!-- display random preset -->
            <Border BorderBrush="Gray"
                    BorderThickness="1"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Generated Preset"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <TextBlock x:Name="RaceResult"
                               Text="Race: —"
                               Margin="0,3"/>

                    <TextBlock x:Name="SexResult"
                               Text="Sex: —"
                               Margin="0,3"/>

                    <TextBlock x:Name="AgeResult"
                               Text="Age: —"
                               Margin="0,3"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </Grid>

</Window>